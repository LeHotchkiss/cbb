{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
        "name": "cbb",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/cbb",
        "args": ["-p", "test.cml", "-a"],
        "stopAtEntry": false,
        "cwd": "/home/hotchkiss/cpp/cbb",
        "environment": [ {"name" : "PATH", "value" : "/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/lib/jvm/default/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl:/home/hotchkiss/path:/home/hotchkiss/cpp/cbb"} ],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    }
    ]
}
