#!/bin/sh

echo "Building Hotchlib..."

cd ./cml-lang/hotchlib
./build-static

if [ $? -ne 0 ]; then
    echo "Hotchlib build failed"
    exit 1
fi

cd ../..
mv ./cml-lang/hotchlib/libhotch.a ./libs/libhotch.a

echo "Building CML..."

cd ./cml-lang
./build

if [ $? -ne 0 ]; then
    echo "CML build failed"
    exit 1
fi

cd ..
mv ./cml-lang/libcml.a ./libs/libcml.a
rm ./cml-lang/libcml.so

echo "Building CBB..."

rm -r ./.obj
mkdir ./.obj

cd src

for FILE in $(find . -maxdepth 1 -name "*.cpp"); do
    g++ -std=c++17 -O2 -c $FILE -o "../.obj/$FILE.o" -I "../src" -I"../cml-lang/include" -I"../cml-lang/hotchlib/include"

    if [ $? -ne 0 ]; then
        echo "Compilation failed"
        exit 1
    fi 
done

cd ..

g++ $(find ./.obj -name "*.o") -o cbb -L"./libs" -l"cml" -l"hotch"

rm -r ./.obj
