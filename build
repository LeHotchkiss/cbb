#!/bin/sh

echo "Building CML..."

cd ./cml-lang
./build

if [ $? -ne 0 ]; then
    echo "CML build failed"
    exit 1
fi

cd ..
mv ./cml-lang/libcml.a ./libs/libcml.a > /dev/null 2>&1
rm ./cml-lang/libcml.so > /dev/null 2>&1

echo "Building CBB..."

rm -r ./.obj > /dev/null 2>&1
mkdir ./.obj > /dev/null 2>&1

cd src

for FILE in $(find . -maxdepth 1 -name "*.cpp"); do
    g++ -std=c++17 -fno-exceptions -O2 -c $FILE -o "../.obj/$FILE.o" -I "../src" -I"../cml-lang/include" -I"../cml-lang/hotchlib/include" -I"../cml-lang"

    if [ $? -ne 0 ]; then
        echo "Compilation failed"
        exit 1
    fi 
done

cd ..

g++ $(find ./.obj -name "*.o") -o cbb -L"./libs" -l"cml" -l"hotch"

rm -r ./.obj > /dev/null 2>&1

echo "Done!"
./cbb -v
